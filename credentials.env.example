# Jarvis Credentials
# Copy to ~/.config/jarvis/credentials.env and fill in your values.
# This file is loaded by systemd services via EnvironmentFile=.
# NEVER commit actual credentials to git.

# Apple Music API (optional — for music data collection)
# See: https://developer.apple.com/documentation/applemusicapi
APPLE_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
APPLE_MUSIC_USER_TOKEN=

# Pocket Casts (optional — for podcast data collection)
POCKETCASTS_EMAIL=
POCKETCASTS_PASSWORD=

# Health Auto Export webhook (optional — for Apple Health data)
# Set this to a random token, then configure the same token in the iOS app
HEALTH_WEBHOOK_TOKEN=

# Last.fm API (optional — alternative to Apple Music)
LASTFM_API_KEY=
LASTFM_USERNAME=

# ElevenLabs TTS (optional — for Jarvis voice output)
# Get your API key from https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=
