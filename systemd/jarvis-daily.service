After=graphical-session.target

[Service]
Type=oneshot
WorkingDirectory=/home/samuel-jenkins/Projects/llm-wiki
ExecStart=/home/samuel-jenkins/Projects/llm-wiki/scripts/run-jarvis.sh daily-briefing
Environment=HOME=/home/samuel-jenkins
Environment=PATH=/home/samuel-jenkins/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=45min
