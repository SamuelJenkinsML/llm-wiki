[Unit]
Description=Jarvis Project Status Update
After=graphical-session.target

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
ExecStart=@@REPO_DIR@@/scripts/run-jarvis.sh project-status
Environment=HOME=@@HOME@@
Environment=PATH=@@HOME@@/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=300
